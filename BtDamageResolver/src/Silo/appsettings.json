{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Orleans": "Warning",
      "Microsoft": "Warning"
    }
  },
  "ClusterOptions": {
    "Invariant": "Npgsql"
  },
  "ConnectionStrings": {
    "Postgres": "User ID=USERNAME;Password=PASSWORD;Host=resolverpostgres;Port=5432;Database=BtDamageResolver;SSL Mode=Disable;",
    "Redis": "redis:6379,password=PASSWORD"
  },
  "CompressionOptions": {
    "Provider": "Brotli",
    "Quality": 4
  }
}
